<?xml version="1.0" encoding="utf-8"?>
<XnaContent xmlns:Graphics="Microsoft.Xna.Framework.Content.Pipeline.Graphics">
  <Asset Type="Graphics:FontDescription">
    <!-- File must sit next to this .spritefont (Linux pipeline does not use Windows Segoe UI). -->
    <FontName>LiberationSans-Bold</FontName>
    <Size>14</Size>
    <Spacing>0</Spacing>
    <UseKerning>true</UseKerning>
    <Style>Regular</Style>
    <CharacterRegions>
      <CharacterRegion>
        <Start>&#48;</Start>
        <End>&#57;</End>
      </CharacterRegion>
    </CharacterRegions>
  </Asset>
</XnaContent>
