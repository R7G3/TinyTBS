<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>TinyTBS.Game</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Gum.MonoGame" Version="2026.8.3.1" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
    <PackageReference Include="MonoGame.Extended" Version="6.1.1" />
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.5.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\TinyTBS.Engine\TinyTBS.Engine.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Bundled vanilla tinymod sources (from TinyTBS.Content/Vanilla). Map scripts are data for Roslyn, not project compile. -->
    <Compile Remove="..\TinyTBS.Content\Vanilla\**\*" />
    <None Include="..\TinyTBS.Content\Vanilla\**\*"
          Link="Vanilla\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
