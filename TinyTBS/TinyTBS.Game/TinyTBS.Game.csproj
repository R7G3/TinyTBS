<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>TinyTBS.Game</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="TinyTBS.Rules.Ai" />
    <Using Include="TinyTBS.Rules.Buildings" />
    <Using Include="TinyTBS.Rules.Levels" />
    <Using Include="TinyTBS.Rules.Maps" />
    <Using Include="TinyTBS.Rules.Match" />
    <Using Include="TinyTBS.Rules.Modules" />
    <Using Include="TinyTBS.Rules.Themes" />
    <Using Include="TinyTBS.Rules.Units" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Gum.MonoGame" />
    <PackageReference Include="MonoGame.Extended" />
    <PackageReference Include="MonoGame.Framework.DesktopGL" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\TinyTBS.Engine\TinyTBS.Engine.csproj" />
    <ProjectReference Include="..\TinyTBS.Rules\TinyTBS.Rules.csproj" />
    <ProjectReference Include="..\TinyTBS.Scripting.Api\TinyTBS.Scripting.Api.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Bundled vanilla tinymod sources (from TinyTBS.Content/Vanilla). Map scripts are data for Roslyn, not project compile. -->
    <Compile Remove="..\TinyTBS.Content\Vanilla\**\*" />
    <None Include="..\TinyTBS.Content\Vanilla\**\*" Link="Vanilla\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- About screen: one assembly metadata entry per central PackageVersion (Directory.Packages.props). -->
  <Target Name="AddSolutionLibraryMetadata" BeforeTargets="GetAssemblyAttributes">
    <ItemGroup>
      <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
        <_Parameter1>TinyTBS.SolutionLibrary</_Parameter1>
        <_Parameter2>%(PackageVersion.Identity) %(PackageVersion.Version)</_Parameter2>
      </AssemblyAttribute>
    </ItemGroup>
  </Target>
</Project>
